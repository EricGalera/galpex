# GALPEX: front controller. Única carpeta pública.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Archivos ocultos: prohibido.
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# El único PHP que se ejecuta es index.php: si alguien lograra subir otro .php a esta carpeta, no correría.
<FilesMatch "\.(php|phtml|phar|php\d)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# Las cabeceras de seguridad de las páginas las pone PHP (app/Core/Security.php);
# acá se agregan a los archivos estáticos (CSS, JS, fuentes, imágenes).
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
AddType font/woff2 .woff2
AddType image/svg+xml .svg
