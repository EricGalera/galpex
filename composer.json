{
    "name": "galpex/galpex",
    "type": "project",
    "description": "GALPEX: plataforma de inversión con dinero virtual y cotizaciones reales (BYMA, Nueva York, dólar y cripto).",
    "keywords": [
        "laravel",
        "broker",
        "inversiones",
        "byma",
        "finanzas"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^11.45"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:unit": "@php tests/run.php Unit",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1"
    },
    "scripts-descriptions": {
        "format": "Formatea el código con el estilo PER (Laravel Pint)",
        "format:check": "Verifica el formato sin modificar archivos",
        "analyse": "Análisis estático con PHPStan (nivel 6)",
        "check": "Formato + análisis estático + pruebas: lo mismo que corre la integración continua"
    }
}
