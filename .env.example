# ─────────────────────────────────────────────
#  GALPEX — variables de entorno
#  GALPEX crea el .env solo en la primera visita a partir de este archivo.
# ─────────────────────────────────────────────
APP_ENV=local
# Detalle técnico de los errores. Aunque esté en true, solo se ve desde esta misma computadora.
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Se genera sola en la instalación. Cifra las claves de exchanges conectados.
APP_KEY=
# Solo si la detección automática falla (ej.: /galpex)
# APP_BASE_PATH=/galpex

# ── Seguridad ──
# Minutos sin uso hasta que se cierra la sesión, y horas máximas de una sesión
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Instalar y actualizar solo se permite desde esta computadora. true = también desde otras PCs de la red (no recomendado)
SETUP_ALLOW_REMOTE=false

# Base de datos (valores por defecto de XAMPP)
# Recomendado: crear en phpMyAdmin un usuario propio para GALPEX con contraseña y usarlo acá en vez de root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galpex
DB_USERNAME=root
DB_PASSWORD=

# ── Proveedores de datos de mercado ──
# GALPEX usa solo datos reales. data912 (BYMA), Yahoo Finance, DolarApi y Binance funcionan SIN clave.
# Las siguientes claves son opcionales: suman fuentes de respaldo, fundamentales y calendario de resultados.
# Twelve Data: https://twelvedata.com/pricing  (plan Basic gratuito: 8 req/min, 800/día)
TWELVEDATA_API_KEY=
# Finnhub: https://finnhub.io/register  (gratis: 60 req/min, cotizaciones + noticias)
FINNHUB_API_KEY=
# Alpha Vantage: https://www.alphavantage.co/support/#api-key  (gratis: 25 req/día)
ALPHAVANTAGE_API_KEY=
# Fuentes públicas sin clave (poné false para desactivar alguna)
DATA912_ENABLED=true
YAHOO_ENABLED=true
BINANCE_ENABLED=true

# Segundos que se reutiliza una cotización antes de pedirla de nuevo
QUOTE_TTL_SECONDS=60
# Tiempo máximo de espera por proveedor (segundos)
HTTP_TIMEOUT=8
# Ruta a cacert.pem solo si cURL de XAMPP da error de certificado SSL (GALPEX ya busca el de XAMPP)
HTTP_CA_BUNDLE=

# Operaciones con dinero virtual (las comisiones están en config/commissions.php)
RISK_FREE_RATE=0.04
